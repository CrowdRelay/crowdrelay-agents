# Agent service bind address
AGENT_SERVICE_BIND=0.0.0.0:8095

# CrowdRelay Postgres (read-only access for MCP tools + own tables)
DATABASE_URL=postgres://crowdrelay:password@localhost:5432/crowdrelay

# HMAC auth key — must match CONTROL_PLANE_MANAGEMENT_MASTER_KEY in control plane
AGENT_SERVICE_AUTH_KEY=your-management-master-key

# Encryption key for credential vault (32 bytes = 64 hex chars)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SERVICE_ENCRYPTION_KEY=your-64-char-hex-encryption-key

# Comma-separated list of allowed CORS origins (e.g. the control plane URL)
# If unset, CORS is disabled — requests must be same-origin.
# Example: https://control.virya.music,https://staging.control.virya.music
AGENT_SERVICE_CORS_ORIGINS=

# OpenCode Zen token (optional — free tier works without, but rate limits apply)
# Get from: opencode auth login --provider zen
OPENCODE_ZEN_TOKEN=

# OpenCode server URL (optional — if running separately)
OPENCODE_SERVER_URL=

# Platform-level fallback API keys (optional — tenants can add their own per-workspace)
GOOGLE_API_KEY=
GROQ_API_KEY=

# Google OAuth (optional — enables "Connect Google" button in UI)
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OpenRouter OAuth (optional — "Sign in with OpenRouter", PKCE, returns API key)
# https://openrouter.ai/settings/keys
OPENROUTER_OAUTH_CLIENT_ID=

# Anthropic OAuth (experimental — Claude plan quota, PKCE)
# https://console.anthropic.com/
ANTHROPIC_OAUTH_CLIENT_ID=

# OpenAI OAuth (experimental — ChatGPT plan, PKCE, Codex endpoint adapter)
# https://platform.openai.com/
OPENAI_OAUTH_CLIENT_ID=

# GitHub Copilot OAuth (experimental — device flow, Copilot plan quota)
# https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=

# Encryption key rotation — decrypt-only fallback while rotating
# AGENT_SERVICE_ENCRYPTION_KEY. Set during key rotation, unset after.
AGENT_SERVICE_PREVIOUS_ENCRYPTION_KEY=

# Outcome emission kill switch — when "false", runner stores results but
# does not write agent_outcomes rows (Rust worker has nothing to process).
AGENT_OUTCOMES_ENABLED=true

# Scheduler kill switch — when "false", the 60s ticker does not fire tasks.
AGENT_SCHEDULER_ENABLED=true

# Default monthly spend ceiling per workspace, in micro-USD (1e-6 USD).
# $5.00 default. Override per-workspace via POST /budgets.
AGENT_DEFAULT_MONTHLY_BUDGET_MICRO_USD=5000000
