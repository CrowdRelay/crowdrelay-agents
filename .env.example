# Agent service bind address
AGENT_SERVICE_BIND=0.0.0.0:8095

# CrowdRelay Postgres (read-only access for MCP tools + own tables)
DATABASE_URL=postgres://crowdrelay:password@localhost:5432/crowdrelay

# HMAC auth key — must match CONTROL_PLANE_MANAGEMENT_MASTER_KEY in control plane
AGENT_SERVICE_AUTH_KEY=your-management-master-key

# Encryption key for credential vault (32 bytes = 64 hex chars)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SERVICE_ENCRYPTION_KEY=your-64-char-hex-encryption-key

# OpenCode Zen token (optional — free tier works without, but rate limits apply)
# Get from: opencode auth login --provider zen
OPENCODE_ZEN_TOKEN=

# OpenCode server URL (optional — if running separately)
OPENCODE_SERVER_URL=

# Platform-level fallback API keys (optional — tenants can add their own per-workspace)
GOOGLE_API_KEY=
GROQ_API_KEY=

# Google OAuth (optional — enables "Connect Google" button in UI)
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Redirect URI must match what's configured in Google Cloud Console
# Format: https://your-control-plane-domain/api/v1/tenants/:slug/agents/oauth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
