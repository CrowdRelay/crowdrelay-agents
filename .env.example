# Agent service bind address
AGENT_SERVICE_BIND=0.0.0.0:8095

# CrowdRelay Postgres (read-only access for MCP tools + own tables)
DATABASE_URL=postgres://crowdrelay:password@localhost:5432/crowdrelay

# HMAC auth key — must match CONTROL_PLANE_MANAGEMENT_MASTER_KEY in control plane
AGENT_SERVICE_AUTH_KEY=your-management-master-key

# OpenCode Zen token (optional — free tier works without, but rate limits apply)
# Get from: opencode auth login --provider zen
OPENCODE_ZEN_TOKEN=

# OpenCode server URL (optional — if running separately)
# If not set, the agent service will start its own OpenCode server
OPENCODE_SERVER_URL=

# Optional: tenant-provided API keys for higher limits
GOOGLE_API_KEY=
GROQ_API_KEY=
